---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { SITE } from '../config';
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}
const { t } = Astro.props;
---

<section class="relative px-4 py-16 sm:px-6 sm:py-24">
  <div class="cta relative mx-auto max-w-6xl overflow-hidden rounded-[36px] px-6 py-16 text-center sm:px-12 sm:py-24" data-reveal id="cta">
    <div class="cta-bg" aria-hidden="true"></div>
    <div class="bg-grid absolute inset-0 opacity-70" aria-hidden="true"></div>

    <div class="relative">
      <div class="mx-auto mb-8 flex w-fit items-center gap-3 rounded-full border border-white/10 bg-[#060a12] py-2 pr-5 pl-2.5 text-sm text-white shadow-2xl">
        <Logo size={30} />
        <span class="robot-eyes" data-track><i class="eye"></i><i class="eye"></i></span>
        <span class="font-semibold tabular-nums" data-clock>09.41</span>
      </div>
      <h2 class="mx-auto max-w-3xl text-4xl font-extrabold tracking-tight text-balance text-white sm:text-6xl">{t.cta.title}</h2>
      <p class="mt-5 text-lg text-white/70">{t.cta.subtitle}</p>
      <a href={SITE.downloads.exe} download class="btn btn-primary mt-10 h-14 px-8 text-base">
        <Icon name="windows" size={18} />
        {t.cta.button}
      </a>
      <p class="mt-4 text-xs text-white/50">{t.hero.meta}</p>
    </div>
  </div>
</section>

<style>
  .cta {
    background: #05070d;
    border: 1px solid rgb(255 255 255 / 0.08);
    --grid-line: rgb(255 255 255 / 0.05);
  }
  .cta-bg {
    position: absolute;
    inset: -40%;
    background: conic-gradient(from 0deg, #00e5ff, #1aa3ff, #05070d 30%, #05070d 50%, #ffe81a 65%, #ff9a1f, #05070d 85%, #00e5ff);
    filter: blur(80px);
    opacity: 0.45;
    animation: spin-slow 18s linear infinite;
  }
</style>
