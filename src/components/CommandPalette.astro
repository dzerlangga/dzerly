---
import Icon from './Icon.astro';
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const pl = t.palette;
let n = 0;
const items = [
  ...pl.sectionList.map(([href, label]) => ({ type: 'section', label, target: href, sub: '' })),
  ...t.features.categories.flatMap((c) =>
    c.items.map((it) => ({ type: 'feature', label: it.title, target: `f-${n++}`, sub: c.title, desc: it.desc })),
  ),
];
---

<dialog id="palette" class="palette" aria-label={t.nav.search}>
  <div class="pal-box">
    <div class="flex items-center gap-3 border-b border-white/[.07] px-4">
      <span class="robot-eyes" data-track><i class="eye"></i><i class="eye"></i></span>
      <input
        id="pal-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder={pl.placeholder}
        class="h-14 flex-1 bg-transparent text-[15px] text-white outline-none placeholder:text-[#6b7b8f]"
        role="combobox"
        aria-expanded="true"
        aria-controls="pal-list"
      />
      <span class="kbd-p">Esc</span>
    </div>
    <ul id="pal-list" role="listbox" class="max-h-[min(60vh,420px)] overflow-y-auto p-2"></ul>
    <div class="flex items-center gap-4 border-t border-white/[.07] px-4 py-2.5 text-[11px] text-[#8da0b5]">
      <span class="flex items-center gap-1.5"><span class="kbd-p">↑</span><span class="kbd-p">↓</span>{pl.navigate}</span>
      <span class="flex items-center gap-1.5"><span class="kbd-p">↵</span>{pl.open}</span>
      <span class="ml-auto hidden items-center gap-1 sm:flex"><span class="kbd-p">Ctrl</span><span class="kbd-p">Alt</span><span class="kbd-p">Space</span></span>
    </div>
  </div>
  <script type="application/json" id="pal-data" set:html={JSON.stringify({ items, labels: { sections: pl.sections, features: pl.features, calc: pl.calc, empty: pl.empty } })} />
  <div hidden id="pal-icons">
    <span data-k="section"><Icon name="arrow-right" size={15} /></span>
    <span data-k="feature"><Icon name="sparkles" size={15} /></span>
    <span data-k="calc"><Icon name="calc" size={15} /></span>
  </div>
</dialog>

<style>
  .palette {
    width: min(640px, calc(100vw - 24px));
    max-width: none;
    margin: 12vh auto auto;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  /* Tanpa backdrop-filter: blur layar penuh membuat frame pertama tersendat */
  .palette::backdrop {
    background: rgb(2 4 10 / 0.68);
  }
  .palette[open]::backdrop {
    animation: pal-fade 0.25s ease;
  }
  @keyframes pal-fade {
    from { opacity: 0; }
  }
  .pal-box {
    overflow: hidden;
    border-radius: 23px;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(8 12 20 / 0.96);
    color: #d6e3ef;
    box-shadow: 0 40px 100px -20px rgb(0 0 0 / 0.8), 0 0 0 1px rgb(42 212 255 / 0.08);
  }
  /* Hanya opacity + transform → berjalan di compositor, mulus */
  .palette[open] .pal-box {
    animation: pal-in 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes pal-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
    }
  }
  #pal-input:focus-visible {
    outline: none;
  }
  .kbd-p {
    padding: 1px 6px;
    border-radius: 5px;
    border: 1px solid rgb(255 255 255 / 0.12);
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: #8da0b5;
  }
  :global(.pal-group) {
    padding: 10px 10px 6px;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b7b8f;
  }
  :global(.pal-item) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border-radius: 13px;
    cursor: pointer;
    font-size: 14px;
  }
  :global(.pal-item[aria-selected='true']) {
    background: rgb(42 212 255 / 0.12);
    color: #fff;
  }
  :global(.pal-ico) {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    color: #2ad4ff;
    background: rgb(255 255 255 / 0.05);
  }
  :global(.pal-sub) {
    margin-left: auto;
    flex: none;
    font-size: 11px;
    color: #8da0b5;
  }
  :global(.pal-item mark) {
    color: #2ad4ff;
    background: none;
  }
</style>

<script>
  type Item = { type: string; label: string; target: string; sub: string; desc?: string };
  const dlg = document.getElementById('palette') as HTMLDialogElement;
  const input = document.getElementById('pal-input') as HTMLInputElement;
  const list = document.getElementById('pal-list')!;
  const data = JSON.parse(document.getElementById('pal-data')!.textContent!);
  const items: Item[] = data.items;
  const L = data.labels;
  const icons = Object.fromEntries([...document.querySelectorAll<HTMLElement>('#pal-icons [data-k]')].map((e) => [e.dataset.k!, e.innerHTML]));
  const lang = document.documentElement.lang;
  let results: Item[] = [];
  let sel = 0;

  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const hi = (label: string, q: string) => {
    if (!q) return esc(label);
    const i = norm(label).indexOf(q);
    if (i < 0) return esc(label);
    return esc(label.slice(0, i)) + '<mark>' + esc(label.slice(i, i + q.length)) + '</mark>' + esc(label.slice(i + q.length));
  };

  // Hitung cepat: hanya angka & operator dasar yang diizinkan
  const calc = (q: string) => {
    const expr = q.replace(/,/g, '.').replace(/x/gi, '*').replace(/\s/g, '');
    if (!/^[\d.+\-*/()%]+$/.test(expr) || !/\d[+\-*/%]/.test(expr)) return null;
    try {
      const v = Function(`"use strict";return (${expr})`)();
      if (typeof v !== 'number' || !isFinite(v)) return null;
      return v.toLocaleString(lang === 'id' ? 'id-ID' : 'en-US', { maximumFractionDigits: 6 });
    } catch {
      return null;
    }
  };

  const render = () => {
    const raw = input.value.trim();
    const q = norm(raw);
    const words = q.split(/\s+/).filter(Boolean);
    results = items.filter((it) => {
      const hay = norm(`${it.label} ${it.sub} ${it.desc ?? ''}`);
      return words.every((w) => hay.includes(w));
    });
    // Judul yang cocok di depan
    results.sort((a, b) => Number(norm(b.label).includes(q)) - Number(norm(a.label).includes(q)));
    const c = calc(raw);
    if (c !== null) results.unshift({ type: 'calc', label: `= ${c}`, target: '', sub: L.calc });
    if (!q) results = items.slice(0, 9).concat(items.filter((i) => i.type === 'feature').slice(0, 5));
    sel = 0;

    list.innerHTML = '';
    if (!results.length) {
      list.innerHTML = `<li class="px-3 py-8 text-center text-sm text-[#8da0b5]">${esc(L.empty)}</li>`;
      return;
    }
    let lastType = '';
    results.forEach((it, i) => {
      if (it.type !== lastType && it.type !== 'calc') {
        const g = document.createElement('li');
        g.className = 'pal-group';
        g.textContent = it.type === 'section' ? L.sections : L.features;
        g.setAttribute('role', 'presentation');
        list.appendChild(g);
      }
      lastType = it.type;
      const li = document.createElement('li');
      li.className = 'pal-item';
      li.setAttribute('role', 'option');
      li.dataset.i = String(i);
      li.innerHTML = `<span class="pal-ico">${icons[it.type]}</span><span class="truncate">${hi(it.label, q)}</span><span class="pal-sub">${esc(it.sub)}</span>`;
      li.addEventListener('mousemove', () => select(i));
      li.addEventListener('click', () => go(i));
      list.appendChild(li);
    });
    select(0);
  };

  const select = (i: number) => {
    sel = i;
    list.querySelectorAll<HTMLElement>('.pal-item').forEach((el) => {
      const on = Number(el.dataset.i) === i;
      el.setAttribute('aria-selected', String(on));
      if (on) el.scrollIntoView({ block: 'nearest' });
    });
  };

  const go = (i: number) => {
    const it = results[i];
    if (!it) return;
    if (it.type === 'calc') {
      navigator.clipboard?.writeText(it.label.replace(/^= /, '')).catch(() => {});
      input.value = it.label.replace(/^= /, '');
      render();
      return;
    }
    close();
    if (it.type === 'section') {
      document.querySelector(it.target)?.scrollIntoView({ behavior: 'smooth' });
      history.replaceState(null, '', it.target);
    } else {
      window.dispatchEvent(new CustomEvent('dz:feature', { detail: it.target }));
    }
  };

  const open = () => {
    if (dlg.open) return;
    input.value = '';
    render();
    dlg.showModal();
    input.focus();
  };
  const close = () => dlg.open && dlg.close();

  input.addEventListener('input', render);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      select(Math.min(results.length - 1, sel + 1));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      select(Math.max(0, sel - 1));
    } else if (e.key === 'Enter') {
      e.preventDefault();
      go(sel);
    }
  });
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) close();
  });
  window.addEventListener('dz:palette', open);
  document.addEventListener('keydown', (e) => {
    const mod = e.ctrlKey || e.metaKey;
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target as HTMLElement).tagName);
    if ((mod && e.altKey && e.code === 'Space') || (mod && e.key.toLowerCase() === 'k') || (e.key === '/' && !typing)) {
      e.preventDefault();
      dlg.open ? close() : open();
    }
  });
</script>
