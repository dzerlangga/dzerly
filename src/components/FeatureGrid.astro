---
import Icon from './Icon.astro';
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const f = t.features;
const total = f.categories.reduce((n, c) => n + c.items.length, 0);
let n = 0;
---

<section id="fitur" class="relative py-24 sm:py-32">
  <div class="bg-grid pointer-events-none absolute inset-0 rotate-180 opacity-60" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{f.eyebrow}</p>
        <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-balance sm:text-5xl">{f.title}</h2>
        <p class="mt-4 text-muted">{f.subtitle}</p>
      </div>
      <div class="text-right" data-reveal style="--d:1">
        <p class="text-gradient text-6xl font-extrabold tracking-tighter tabular-nums sm:text-7xl" data-count={total}>{total}</p>
        <p class="text-sm font-semibold text-muted">{f.eyebrow.toLowerCase()}</p>
      </div>
    </div>

    <!-- Filter kategori -->
    <div class="chips-scroll -mx-4 mt-10 overflow-x-auto px-4 pb-2 sm:mx-0 sm:px-0" data-reveal>
      <div class="flex w-max gap-2 sm:w-auto sm:flex-wrap" role="tablist" id="feat-filter">
        <button class="chip-btn" role="tab" aria-selected="true" data-filter="all">
          <Icon name="sparkles" size={15} />{f.all}<span class="count">{total}</span>
        </button>
        {
          f.categories.map((c) => (
            <button class="chip-btn" role="tab" aria-selected="false" data-filter={c.id}>
              <Icon name={c.icon} size={15} />
              {c.title}
              <span class="count">{c.items.length}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" id="feat-grid">
      {
        f.categories.map((c) =>
          c.items.map((it) => {
            const i = n++;
            return (
              <article
                class="feat spot glass rounded-[23px] p-5"
                data-cat={c.id}
                data-feature={it.title}
                id={`f-${i}`}
                style={`--vt: feat-${i}`}
              >
                <div class="flex items-start gap-4">
                  <span class="feat-ico">
                    <Icon name={it.icon} size={20} />
                  </span>
                  <div class="min-w-0">
                    <h3 class="font-bold leading-snug">{it.title}</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-muted">{it.desc}</p>
                  </div>
                </div>
                <span class="cat-tag">{c.title}</span>
              </article>
            );
          }),
        )
      }
    </div>
  </div>
</section>

<style>
  .chips-scroll {
    scrollbar-width: none;
  }
  .chip-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    padding: 0 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
    transition: all 0.25s var(--ease-spring);
  }
  .chip-btn:hover {
    color: var(--text);
    transform: translateY(-1px);
  }
  .chip-btn[aria-selected='true'] {
    color: #03121a;
    border-color: transparent;
    background: linear-gradient(100deg, #2ad4ff, #8be9ff);
    box-shadow: 0 8px 22px -10px rgb(42 212 255 / 0.8);
  }
  .count {
    padding: 0 0.4rem;
    border-radius: 99px;
    font-size: 0.7rem;
    background: rgb(127 127 127 / 0.15);
  }
  .feat {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    transition: transform 0.35s var(--ease-spring), border-color 0.3s;
  }
  .feat:hover {
    transform: translateY(-4px);
  }
  :global(#feat-grid.vt) .feat {
    view-transition-name: var(--vt);
  }
  .feat[hidden] {
    display: none;
  }
  .feat.flash {
    animation: flash 1.6s ease;
  }
  @keyframes flash {
    0%, 100% { box-shadow: 0 0 0 0 rgb(42 212 255 / 0); }
    20% { box-shadow: 0 0 0 3px rgb(42 212 255 / 0.7); }
  }
  .feat-ico {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    color: var(--cyan-ink);
    background: linear-gradient(135deg, rgb(42 212 255 / 0.16), rgb(255 154 31 / 0.1));
    border: 1px solid rgb(42 212 255 / 0.15);
    transition: transform 0.4s var(--ease-spring);
  }
  .feat:hover .feat-ico {
    transform: rotate(-8deg) scale(1.08);
  }
  .cat-tag {
    align-self: flex-start;
    margin-left: 60px;
    padding: 2px 8px;
    border-radius: 99px;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--muted);
    border: 1px solid var(--line);
  }
</style>

<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>('#feat-filter [data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('#feat-grid .feat')];
  const grid = document.getElementById('feat-grid')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const apply = (id: string) => {
    btns.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.filter === id)));
    cards.forEach((c) => (c.hidden = id !== 'all' && c.dataset.cat !== id));
  };
  const filter = (id: string) => {
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (!doc.startViewTransition || reduce) return apply(id);
    grid.classList.add('vt');
    const vt = doc.startViewTransition(() => apply(id)) as { finished: Promise<void> };
    vt.finished.finally(() => grid.classList.remove('vt'));
  };
  btns.forEach((b) => b.addEventListener('click', () => filter(b.dataset.filter!)));

  // Dipanggil oleh palet perintah: tampilkan & sorot kartu fitur
  window.addEventListener('dz:feature', (e) => {
    const card = document.getElementById((e as CustomEvent<string>).detail);
    if (!card) return;
    if (card.hidden) apply('all');
    card.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    card.classList.remove('flash');
    void card.offsetWidth;
    card.classList.add('flash');
  });

  // Angka total menghitung naik
  const counter = document.querySelector<HTMLElement>('[data-count]')!;
  const target = Number(counter.dataset.count);
  new IntersectionObserver(
    ([e], io) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / 1200);
        counter.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    },
    { threshold: 0.5 },
  ).observe(counter);
</script>
