---
import Icon from './Icon.astro';
import { SITE } from '../config';
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const s = t.stats;
const icons = ['sparkles', 'download', 'windows', 'globe'];
---

<section id="statistik" class="relative pt-24 sm:pt-32">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div
      class="stats glass relative overflow-hidden rounded-[32px] p-6 sm:p-10"
      data-reveal
      data-repo={SITE.githubRepo}
      id="stats"
    >
      <div class="stats-glow" aria-hidden="true"></div>
      <div class="relative grid items-center gap-10 lg:grid-cols-[1.1fr_1fr]">
        <div>
          <p class="eyebrow">{s.eyebrow}</p>

          <!-- Keadaan: ada data -->
          <div data-state="count" hidden>
            <p class="mt-5 text-lg font-semibold text-muted">{s.title}</p>
            <p class="flex flex-wrap items-baseline gap-x-3">
              <span class="text-gradient text-6xl font-extrabold tracking-tighter tabular-nums sm:text-8xl" id="stats-total">0</span>
              <span class="text-2xl font-bold text-muted">{s.times}</span>
            </p>
            <div class="mt-6 max-w-md">
              <div class="flex h-2.5 overflow-hidden rounded-full bg-surface-2">
                <i class="split-exe h-full" id="stats-bar-exe" style="width:0%"></i>
                <i class="split-msi h-full" id="stats-bar-msi" style="width:0%"></i>
              </div>
              <div class="mt-2.5 flex justify-between text-xs font-semibold text-muted">
                <span class="flex items-center gap-1.5"><i class="size-2 rounded-full bg-cyan"></i>{s.exe} · <b class="text-ink tabular-nums" id="stats-exe">0</b></span>
                <span class="flex items-center gap-1.5"><i class="size-2 rounded-full bg-orange"></i>{s.msi} · <b class="text-ink tabular-nums" id="stats-msi">0</b></span>
              </div>
            </div>
          </div>

          <!-- Keadaan: belum ada data / API tidak tersedia -->
          <div data-state="first">
            <h2 class="mt-5 text-3xl font-extrabold tracking-tight text-balance sm:text-4xl">{s.first}</h2>
            <p class="mt-3 max-w-md text-muted">{s.firstSub}</p>
          </div>

          <p class="mt-7 flex flex-wrap items-center gap-2 text-xs font-medium text-muted">
            <span class="live-dot"></span>
            {s.source}
            <span id="stats-date" class="hidden">· {s.released}: <b class="text-ink" id="stats-date-v"></b></span>
          </p>
        </div>

        <ul class="grid grid-cols-2 gap-3">
          {
            s.items.map(([k, v], i) => (
              <li class="spot rounded-[20px] border border-line bg-surface p-4 sm:p-5">
                <span class="mb-3 grid size-9 place-items-center rounded-xl bg-cyan/10 text-cyan-ink">
                  <Icon name={icons[i]} size={17} />
                </span>
                <p class="text-xs font-semibold text-muted">{k}</p>
                <p class="mt-0.5 text-lg font-bold">{v}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .stats-glow {
    position: absolute;
    inset: -40% 40% 30% -20%;
    background: radial-gradient(circle, rgb(42 212 255 / 0.22), transparent 65%);
    filter: blur(40px);
    opacity: calc(var(--glow) * 1.4);
  }
  .split-exe {
    background: linear-gradient(90deg, #2ad4ff, #6fe3ff);
    transition: width 1.2s var(--ease-out-expo);
  }
  .split-msi {
    background: linear-gradient(90deg, #ffc24d, #ff9a1f);
    transition: width 1.2s var(--ease-out-expo) 0.15s;
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0 0 rgb(52 211 153 / 0.6);
    animation: live 1.8s ease-out infinite;
  }
  @keyframes live {
    100% {
      box-shadow: 0 0 0 10px rgb(52 211 153 / 0);
    }
  }
</style>

<script>
  type Stats = { total: number; exe: number; msi: number; date: string };
  const root = document.getElementById('stats')!;
  const repo = root.dataset.repo!;
  const lang = document.documentElement.lang;
  const KEY = `dz-stats:${repo}`;
  const TTL = 30 * 60 * 1000; // 30 menit (batas API GitHub: 60 permintaan/jam per IP)

  const load = async (): Promise<Stats | null> => {
    try {
      const c = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (c && Date.now() - c.at < TTL) return c.data;
    } catch {}
    try {
      const res = await fetch(`https://api.github.com/repos/${repo}/releases?per_page=100`, {
        headers: { Accept: 'application/vnd.github+json' },
      });
      if (!res.ok) return null;
      const releases: { published_at: string; draft: boolean; assets: { name: string; download_count: number }[] }[] = await res.json();
      const data: Stats = { total: 0, exe: 0, msi: 0, date: '' };
      for (const r of releases) {
        if (r.draft) continue;
        if (!data.date || r.published_at > data.date) data.date = r.published_at;
        for (const a of r.assets) {
          const n = a.name.toLowerCase();
          if (n.endsWith('.exe')) data.exe += a.download_count;
          else if (n.endsWith('.msi')) data.msi += a.download_count;
        }
      }
      data.total = data.exe + data.msi;
      try {
        localStorage.setItem(KEY, JSON.stringify({ at: Date.now(), data }));
      } catch {}
      return data;
    } catch {
      return null;
    }
  };

  const fmt = (n: number) => n.toLocaleString(lang === 'id' ? 'id-ID' : 'en-US');
  const countUp = (el: HTMLElement, target: number, ms = 1600) => {
    const t0 = performance.now();
    const step = (now: number) => {
      const p = Math.min(1, (now - t0) / ms);
      el.textContent = fmt(Math.round(target * (1 - Math.pow(1 - p, 4))));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  new IntersectionObserver(
    async ([e], io) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const d = await load();
      if (!d) return;
      if (d.date) {
        document.getElementById('stats-date-v')!.textContent = new Date(d.date).toLocaleDateString(
          lang === 'id' ? 'id-ID' : 'en-US',
          { day: 'numeric', month: 'long', year: 'numeric' },
        );
        document.getElementById('stats-date')!.classList.remove('hidden');
      }
      if (d.total <= 0) return;
      root.querySelector<HTMLElement>('[data-state="first"]')!.hidden = true;
      root.querySelector<HTMLElement>('[data-state="count"]')!.hidden = false;
      countUp(document.getElementById('stats-total')!, d.total);
      countUp(document.getElementById('stats-exe')!, d.exe);
      countUp(document.getElementById('stats-msi')!, d.msi);
      requestAnimationFrame(() => {
        document.getElementById('stats-bar-exe')!.style.width = `${(d.exe / d.total) * 100}%`;
        document.getElementById('stats-bar-msi')!.style.width = `${(d.msi / d.total) * 100}%`;
      });
    },
    { threshold: 0.3 },
  ).observe(root);
</script>
