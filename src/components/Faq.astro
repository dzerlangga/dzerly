---
import Icon from './Icon.astro';
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}
const { t } = Astro.props;
---

<section id="faq" class="relative py-24 sm:py-32">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div data-reveal>
      <p class="eyebrow">{t.faq.eyebrow}</p>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-balance sm:text-5xl">{t.faq.title}</h2>
    </div>

    <div class="grid gap-3" data-reveal style="--d:1">
      {
        t.faq.items.map((it, i) => (
          <details class="faq glass rounded-[23px]" name="faq" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center gap-4 p-5 font-bold sm:p-6 sm:text-lg">
              <span class="flex-1">{it.q}</span>
              <span class="plus">
                <Icon name="plus" size={16} stroke={2.4} />
              </span>
            </summary>
            <div class="answer">
              <p
                class="px-5 pb-6 leading-relaxed text-muted sm:px-6"
                set:html={it.a.replace(/Ctrl \+ Alt \+ Space/g, '<span class="kbd">Ctrl</span> + <span class="kbd">Alt</span> + <span class="kbd">Space</span>')}
              />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq {
    transition: border-color 0.3s, background-color 0.3s;
  }
  .faq[open] {
    border-color: rgb(42 212 255 / 0.3);
    background: var(--surface-2);
  }
  .plus {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition: transform 0.4s var(--ease-spring), background 0.3s, color 0.3s;
  }
  .faq[open] .plus {
    transform: rotate(135deg);
    color: #03121a;
    background: #2ad4ff;
    border-color: transparent;
  }
  /* Animasi buka-tutup (browser yang mendukung ::details-content) */
  @supports selector(::details-content) {
    .faq {
      interpolate-size: allow-keywords;
    }
    .faq::details-content {
      height: 0;
      overflow: clip;
      transition:
        height 0.45s var(--ease-out-expo),
        content-visibility 0.45s allow-discrete;
    }
    .faq[open]::details-content {
      height: auto;
    }
  }
</style>
