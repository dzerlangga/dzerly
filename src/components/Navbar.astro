---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE } from '../config';
import type { Content, Lang } from '../i18n/content';

interface Props {
  t: Content;
  lang: Lang;
}
const { t, lang } = Astro.props;
const home = lang === 'id' ? '/' : '/en/';
---

<header id="nav" class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-4 sm:pt-4">
  <nav
    class="nav-shell glass glass-blur mx-auto flex h-14 max-w-6xl items-center gap-2 rounded-full pr-2 pl-4 shadow-[0_8px_40px_-12px_rgb(0_0_0/0.5)] transition-all duration-500"
    aria-label="Utama"
  >
    <a href={home + '#top'} class="flex items-center gap-2.5 font-extrabold tracking-tight" aria-label="Dzerly">
      <Logo size={28} eager />
      <span class="text-[1.05rem]">Dzerly</span>
    </a>

    <ul class="mx-auto hidden items-center gap-0.5 lg:flex">
      {
        t.nav.links.map((l) => (
          <li>
            <a
              href={l.href}
              data-navlink={l.href.slice(1)}
              class="relative rounded-full px-3.5 py-2 text-sm font-semibold text-muted transition-colors hover:text-ink data-[active]:text-ink"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-1 lg:ml-0">
      <button
        type="button"
        data-open-palette
        class="hidden h-9 items-center gap-2 rounded-full border border-line px-3 text-sm text-muted transition-colors hover:text-ink xl:flex"
        aria-label={t.nav.search}
      >
        <Icon name="search" size={15} />
        <span class="kbd">Ctrl</span><span class="kbd">K</span>
      </button>
      <button
        type="button"
        data-open-palette
        class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-surface-2 hover:text-ink xl:hidden"
        aria-label={t.nav.search}
      >
        <Icon name="search" size={18} />
      </button>

      <div class="hidden items-center rounded-full border border-line p-0.5 text-xs font-bold sm:flex" role="group" aria-label="Language">
        <a href="/" class:list={['rounded-full px-2.5 py-1 transition-colors', lang === 'id' ? 'bg-surface-2 text-ink' : 'text-muted hover:text-ink']} hreflang="id" lang="id">ID</a>
        <a href="/en/" class:list={['rounded-full px-2.5 py-1 transition-colors', lang === 'en' ? 'bg-surface-2 text-ink' : 'text-muted hover:text-ink']} hreflang="en" lang="en">EN</a>
      </div>

      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-surface-2 hover:text-ink"
        aria-label={t.nav.theme}
      >
        <span class="theme-icon-dark"><Icon name="moon" size={18} /></span>
        <span class="theme-icon-light"><Icon name="sun" size={18} /></span>
      </button>

      <a href={SITE.downloads.exe} download class="btn btn-primary btn-sm ml-1 hidden sm:inline-flex">
        <Icon name="windows" size={15} />
        {t.nav.download}
      </a>

      <button
        type="button"
        id="menu-btn"
        class="grid size-9 place-items-center rounded-full text-ink hover:bg-surface-2 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.menu}
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </nav>

  <!-- Menu ponsel: "mengembang" dari navbar seperti kapsul -->
  <div
    id="mobile-menu"
    class="glass glass-blur mx-auto mt-2 max-w-6xl overflow-hidden rounded-[23px] lg:hidden"
    data-open="false"
  >
    <div class="min-h-0">
      <ul class="flex flex-col p-2">
        {
          t.nav.links.map((l) => (
            <li>
              <a href={l.href} class="block rounded-2xl px-4 py-3 text-base font-semibold hover:bg-surface-2">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex items-center justify-between gap-3 border-t border-line p-3">
        <div class="flex items-center rounded-full border border-line p-0.5 text-xs font-bold">
          <a href="/" class:list={['rounded-full px-3 py-1.5', lang === 'id' ? 'bg-surface-2' : 'text-muted']}>ID</a>
          <a href="/en/" class:list={['rounded-full px-3 py-1.5', lang === 'en' ? 'bg-surface-2' : 'text-muted']}>EN</a>
        </div>
        <a href={SITE.downloads.exe} download class="btn btn-primary btn-sm">
          <Icon name="windows" size={15} />
          {t.nav.downloadShort}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  #nav.scrolled .nav-shell {
    max-width: 62rem;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
  }
  [data-navlink][data-active]::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 14px;
    height: 3px;
    border-radius: 3px;
    translate: -50% 0;
    background: linear-gradient(90deg, #2ad4ff, #ff9a1f);
  }
  /* Menu mengembang lewat clip-path + opacity (tanpa animasi layout) */
  #mobile-menu {
    visibility: hidden;
    opacity: 0;
    clip-path: inset(0 0 100% 0 round 23px);
    pointer-events: none;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    transition:
      clip-path 0.45s var(--ease-out-expo),
      opacity 0.25s ease,
      visibility 0s linear 0.45s;
  }
  #mobile-menu[data-open='true'] {
    visibility: visible;
    opacity: 1;
    clip-path: inset(0 0 0 0 round 23px);
    pointer-events: auto;
    transition:
      clip-path 0.5s var(--ease-out-expo),
      opacity 0.2s ease,
      visibility 0s;
  }
  .theme-icon-light {
    display: none;
  }
  :global([data-theme='light']) .theme-icon-light {
    display: block;
  }
  :global([data-theme='light']) .theme-icon-dark {
    display: none;
  }
</style>

<script>
  const nav = document.getElementById('nav')!;
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menu ponsel
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const setOpen = (open: boolean) => {
    menu.dataset.open = String(open);
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => setOpen(menu.dataset.open !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Tema
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) =>
    b.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      const apply = () => {
        root.dataset.theme = next;
        try {
          localStorage.setItem('dz-theme', next);
        } catch {}
      };
      // Transisi lingkaran yang menyebar dari tombol (bila didukung)
      const doc = document as Document & { startViewTransition?: (cb: () => void) => { ready: Promise<void> } };
      if (!doc.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) return apply();
      const r = b.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      doc.startViewTransition(apply).ready.then(() => {
        document.documentElement.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${end}px at ${x}px ${y}px)`] },
          { duration: 550, easing: 'cubic-bezier(.16,1,.3,1)', pseudoElement: '::view-transition-new(root)' },
        );
      });
    }),
  );

  // Tautan aktif sesuai bagian yang terlihat
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-navlink]');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((l) => l.toggleAttribute('data-active', l.dataset.navlink === e.target.id));
      });
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  links.forEach((l) => {
    const s = document.getElementById(l.dataset.navlink!);
    if (s) io.observe(s);
  });
</script>
