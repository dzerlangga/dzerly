---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

interface Props {
  size?: number;
  class?: string;
  eager?: boolean;
}
const { size = 32, class: cls = '', eager = false } = Astro.props;
---

<Image
  src={logo}
  alt="Dzerly"
  width={size * 2}
  height={size * 2}
  style={`width:${size}px;height:${size}px`}
  class={cls}
  loading={eager ? 'eager' : 'lazy'}
  format="webp"
/>
