---
import Icon from './Icon.astro';
import HeroMock from './HeroMock.astro';
import { SITE } from '../config';
import type { Content, Lang } from '../i18n/content';

interface Props {
  t: Content;
  lang: Lang;
}
const { t, lang } = Astro.props;
const h = t.hero;
---

<section id="top" class="relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-28">
  <div class="bg-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="orb top-[-12rem] left-1/2 h-[34rem] w-[34rem] -translate-x-[85%] bg-[#1aa3ff]" aria-hidden="true"></div>
  <div class="orb top-[-8rem] left-1/2 h-[28rem] w-[28rem] translate-x-[10%] bg-[#ff9a1f] opacity-[calc(var(--glow)*0.6)]" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <a
        href="#unduh"
        class="hero-in glass mx-auto mb-7 inline-flex items-center gap-2 rounded-full py-1.5 pr-3 pl-1.5 text-xs font-semibold text-muted transition-colors hover:text-ink"
        style="--i:0"
      >
        <span class="rounded-full bg-gradient-to-r from-cyan to-orange px-2 py-0.5 text-[10px] font-extrabold tracking-wider text-[#03121a]">NEW</span>
        {h.badge}
        <Icon name="arrow-right" size={13} />
      </a>

      <h1 class="text-[2.35rem] leading-[1.06] font-extrabold tracking-[-0.035em] text-balance sm:text-6xl lg:text-[4.4rem]">
        <span class="hero-in block" style="--i:1">{h.titleA}</span>
        <span class="hero-in text-gradient block pb-1" style="--i:2">{h.titleB}</span>
        <span class="hero-in block" style="--i:3">{h.titleC}</span>
      </h1>

      <p class="hero-in mx-auto mt-6 max-w-2xl text-base leading-relaxed text-pretty text-muted sm:text-lg" style="--i:4">
        {h.subtitle}
      </p>

      <div class="hero-in mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" style="--i:5">
        <a href={SITE.downloads.exe} download class="btn btn-primary h-13 w-full px-7 text-base sm:w-auto">
          <Icon name="windows" size={18} />
          {h.primary}
        </a>
        <a href="#fitur" class="btn btn-ghost h-13 w-full px-7 text-base sm:w-auto">
          {h.secondary}
          <Icon name="arrow-down" size={17} />
        </a>
      </div>
      <p class="hero-in mt-4 text-xs font-medium text-muted" style="--i:6">{h.meta}</p>
    </div>

    <div class="hero-in relative mt-14 sm:mt-20" style="--i:7">
      <div class="pointer-events-none absolute inset-x-[10%] -top-10 h-40 rounded-full bg-cyan/20 blur-[90px]" aria-hidden="true"></div>
      <HeroMock t={t} lang={lang} />
    </div>
  </div>
</section>

<style>
  .hero-in {
    opacity: 0;
    transform: translateY(22px);
    filter: blur(8px);
    animation: hero-in 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i) * 90ms + 80ms);
  }
  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  .h-13 {
    height: 3.25rem;
  }
</style>
